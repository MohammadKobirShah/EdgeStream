# Railway services can have a low process/thread limit. Keep Nginx lightweight.
user www-data;
worker_processes 1;
worker_rlimit_nofile 4096;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    # Do not use aio threads on small Railway containers; it can exhaust the PID/thread limit.
    tcp_nopush on;
    open_file_cache max=2000 inactive=5m;
    open_file_cache_valid 2m;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;
    log_format json_cache escape=json '{"timestamp":"$time_iso8601","component":"cache","type":"access","method":"$request_method","path":"$uri","status":$status,"cache_status":"$upstream_cache_status","request_time":$request_time,"upstream_time":"$upstream_response_time","bytes_sent":$bytes_sent,"client_ip":"$remote_addr"}';
    access_log /dev/stdout json_cache;
    error_log /dev/stderr warn;
    # Never cache requests carrying cookies or authorization credentials.
    map $http_authorization $skip_private_auth {
        ""      0;
        default 1;
    }
    map $http_cookie $skip_private_cookie {
        ""      0;
        default 1;
    }
    proxy_cache_path /var/cache/hls levels=1:2 keys_zone=hls_cache:32m ${CACHE_MAX_DIRECTIVE} inactive=60s use_temp_path=off;
    gzip on;
    gzip_types application/vnd.apple.mpegurl audio/mpegurl text/vtt application/x-mpegURL;
    gzip_min_length 256;
    server {
        listen 8080;
        server_name _;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        location = /health { default_type application/json; return 200 '{"status":"ok"}'; }
        # The public root serves the exact manifest configured by ORIGIN_M3U8_URL.
        location = / { include /etc/nginx/conf.d/manifest-origin.inc; proxy_cache_valid 200 2s; add_header Cache-Control "public, max-age=2" always; }
        location ~* \.m3u8$ { include /etc/nginx/conf.d/cache-origin.inc; proxy_cache_valid 200 2s; add_header Cache-Control "public, max-age=2" always; }
        location ~* \.(ts|m4s|mp4|aac)$ { include /etc/nginx/conf.d/cache-origin.inc; proxy_cache_valid 200 60s; add_header Cache-Control "public, max-age=60" always; }
        location ~* \.vtt$ { include /etc/nginx/conf.d/cache-origin.inc; proxy_cache_valid 200 60s; }
        location / { include /etc/nginx/conf.d/cache-origin.inc; proxy_cache_valid 200 60s; add_header Cache-Control "public, max-age=60" always; }
    }
}
