worker_processes auto;
worker_rlimit_nofile 8192;
events { worker_connections 2048; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    aio threads;
    tcp_nopush on;
    open_file_cache max=2000 inactive=5m;
    open_file_cache_valid 2m;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;
    log_format json_cache escape=json '{"timestamp":"$time_iso8601","component":"cache","type":"access","method":"$request_method","path":"$uri","status":$status,"cache_status":"$upstream_cache_status","request_time":$request_time,"upstream_time":"$upstream_response_time","bytes_sent":$bytes_sent,"client_ip":"$remote_addr"}';
    access_log /dev/stdout json_cache;
    error_log /dev/stderr warn;
    proxy_cache_path /var/cache/hls levels=1:2 keys_zone=hls_cache:32m max_size=${CACHE_MAX_SIZE} inactive=60s use_temp_path=off;
    gzip on;
    gzip_types application/vnd.apple.mpegurl audio/mpegurl text/vtt application/x-mpegURL;
    gzip_min_length 256;
    server {
        listen 8080;
        server_name _;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        location = /health { default_type application/json; return 200 '{"status":"ok"}'; }
        location ~* \.m3u8$ { include /etc/nginx/conf.d/cache-proxy.inc; proxy_cache_valid 200 2s; add_header Cache-Control "public, max-age=2" always; }
        location ~* \.(ts|m4s|mp4|aac)$ { include /etc/nginx/conf.d/cache-proxy.inc; proxy_cache_valid 200 60s; add_header Cache-Control "public, max-age=60" always; }
        location ~* \.vtt$ { include /etc/nginx/conf.d/cache-proxy.inc; proxy_cache_valid 200 60s; }
        location / { include /etc/nginx/conf.d/cache-proxy.inc; proxy_cache_valid 200 60s; add_header Cache-Control "public, max-age=60" always; }
    }
}
