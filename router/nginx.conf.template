# Railway services can have a low process/thread limit. Keep Nginx lightweight.
worker_processes 1;
worker_rlimit_nofile 4096;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    # Do not use aio threads on small Railway containers; it can exhaust the PID/thread limit.
    tcp_nopush on;
    log_format json_access escape=json '{"timestamp":"$time_iso8601","component":"router","type":"access","method":"$request_method","path":"$uri","status":$status,"request_time":$request_time,"upstream_time":"$upstream_response_time","upstream_addr":"$upstream_addr","bytes_sent":$bytes_sent,"client_ip":"$edge_client_ip"}';
    access_log /dev/stdout json_access;
    error_log /dev/stderr warn;
    # Cloudflare Tunnel hides the viewer IP in $remote_addr. Prefer the
    # Cloudflare client IP for rate limiting, with a direct-access fallback.
    map $http_cf_connecting_ip $edge_client_ip {
        ""      $remote_addr;
        default $http_cf_connecting_ip;
    }
    limit_req_zone $edge_client_ip zone=edge:10m rate=100r/s;
    include /etc/nginx/conf.d/upstream.conf;
    server {
        listen 8080;
        server_name _;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        location ~ ^/(health|ready|metrics)(/|$) {
            proxy_pass http://127.0.0.1:9090;
            proxy_set_header Host $host;
        }
        location / {
            limit_req zone=edge burst=50 nodelay;
            proxy_pass http://cache_pool;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Accept-Encoding "";
            sub_filter_once off;
            sub_filter_types application/vnd.apple.mpegurl audio/mpegurl application/x-mpegURL text/plain;
            sub_filter "http://${ORIGIN_DOMAIN}" "https://${EDGE_DOMAIN}";
            sub_filter "https://${ORIGIN_DOMAIN}" "https://${EDGE_DOMAIN}";
            proxy_connect_timeout 10s;
            proxy_read_timeout 30s;
            proxy_send_timeout 30s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries 2;
        }
    }
}
